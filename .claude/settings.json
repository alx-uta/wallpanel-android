{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",

      "Bash(./tools/run.sh *)",
      "Bash(tools/run.sh *)",
      "Bash(./tools/instrument.sh *)",
      "Bash(tools/instrument.sh *)",

      "Bash(docker *)",
      "Bash(docker compose *)",

      "Bash(./gradlew *)",
      "Bash(adb *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(yarn *)",
      "Bash(jq *)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git remote *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git --no-pager *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(curl *)",
      "Bash(ip *)",
      "Bash(ping *)",
      "Bash(nc *)",

      "Bash(adb uninstall *)",
      "Bash(adb reboot *)",
      "Bash(docker system prune *)",

      "WebSearch",
      "WebFetch(domain:developer.android.com)",
      "WebFetch(domain:source.android.com)",
      "WebFetch(domain:cs.android.com)",
      "WebFetch(domain:android.googlesource.com)",
      "WebFetch(domain:kotlinlang.org)",
      "WebFetch(domain:docs.gradle.org)",
      "WebFetch(domain:mozilla.github.io)",
      "WebFetch(domain:firefox-source-docs.mozilla.org)",
      "WebFetch(domain:www.home-assistant.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docusaurus.io)",
      "WebFetch(domain:hivemq.github.io)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(rm -rf /*)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)"
    ],
    "ask": [
    ]
  }
}
