# Copy to local.testconfig.properties (repo root) and fill in real values. That file
# is gitignored. Only the `dev` build flavor reads the build settings here -- `qa` and
# `prod` hard-code empty/default credentials and ignore this file entirely. `hassToken`
# is the exception: it belongs to the test harness rather than any build, and never
# reaches the application (see its own note below).
#
# local.properties is reserved for Gradle/SDK configuration (see
# tools/android/container.local.properties). Test credentials live here instead, so
# they read the same whether you build on the host or through ./tools/run.sh in Docker.
#
# On BuildConfig.DEBUG's first launch (BrowserActivityNative.onCreate), these are
# used to seed Configuration (the app's SharedPreferences) once, so a freshly
# installed dev-flavor debug build already has your test Home Assistant URL and
# MQTT broker filled in instead of the built-in defaults. After that first launch
# they're just normal user-editable settings -- delete/reinstall the app to reseed.

# Home Assistant dashboard URL the kiosk should open.
hassUrl=http://homeassistant.local:8123/lovelace/default_view

# Long-lived access token for that Home Assistant, used only by the test harness --
# the application never reads it and it is not compiled into any build. It is what
# lets a test check that Home Assistant really created the MQTT discovery entities
# and gave them the states expected, rather than only checking what was published to
# the broker. Leave it empty to skip those checks.
#
# Create one in Home Assistant under your profile -> Security -> Long-lived access
# tokens. It grants full API access to that instance, so use a dev instance and
# revoke the token when you are done with it.
hassToken=

# MQTT broker connection. Leave broker empty to skip MQTT auto-seeding entirely
# (mqttEnabled only gets set to true if broker is non-blank).
broker=192.168.1.50
brokerPort=1883
brokerTls=false
brokerUsername=wallpanel
brokerPass=changeme

# MQTT client ID and base topic (wallpanel/<baseTopic>/... command/state topics).
clientId=mywallpanel
baseTopic=wallpanel/mywallpanel/

# 4-digit code that unlocks the in-app settings screen.
code=1234
